{
  "manifest_version": 3,
  "name": "PeakTalent PII/BII Annotation Auditor",
  "version": "11.4.13",
  "description": "Highlights PII/BII, credentials and overscrubbed text on PeakTalent review screens and flags wrong labels. Works fully offline.",
  "action": {
    "default_popup": "extension/popup.html",
    "default_title": "PeakTalent Auditor",
    "default_icon": {
      "16": "extension/icons/icon16.png",
      "48": "extension/icons/icon48.png",
      "128": "extension/icons/icon128.png"
    }
  },
  "icons": {
    "16": "extension/icons/icon16.png",
    "48": "extension/icons/icon48.png",
    "128": "extension/icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://dashboard.peaktalent.ai/*"
      ],
      "js": [
        "extension/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://dashboard.peaktalent.ai/*"
  ],
  "permissions": [
    "activeTab"
  ]
}
